# ── مخرَجات البناء — لا تُلتزَم في مستودع عامّ (~4-5MB لكل حزمة) ──────────────
# كان هنا سطران يستبعدان app-release.aab لكنهما مكتوبان بترميز UTF-16 (بايت
# صفري بين كل حرفين) فلم يكن git يقرؤهما إطلاقاً — قاعدة تبدو قائمة وهي ميّتة،
# أثبته git check-ignore. أُصلح 2026-08-11 وأُعيدت كتابته بـUTF-8.
# أرشيف الحزم المنشورة: Workspace/Releases/SchoolAppyemen/ (فيه README يحدّد الحيّة)
*.aab
*.apk
app/release/

# ── أسرار التوقيع — تعيش في Workspace/Secure/ لا هنا ────────────────────────
keystore.properties
*.jks
*.keystore

# ── تقارير Claude المحلّية — خصائص جهاز لا مشروع، والمستودع عامّ ──────────────
.claude/local-reports/

# ── حالةٌ عابرة تكتبها الهوكس (‏anomaly-seen.json) — تُعاد بتشغيلٍ تالٍ ────────
# 🔴 ولا يُضاف هنا `_docs/anomalies.jsonl`: ذاك **سجلُّ أحداثٍ مؤرَّخة لا يُعاد
#   إنتاجُها** (كلُّ سطرٍ لحظةُ حجبٍ وقعت فعلاً بفرعها وsha)، فيُتتبَّع عمداً.
#   القاعدة الفارقة: ما يُعاد إنتاجُه بأمرٍ يُتجاهَل، وما يوثّق لحظةً زائلة يُتتبَّع.
.claude/tmp/
