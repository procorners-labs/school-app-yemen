<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_webview.xml
    Layout مشترك لـ TeacherActivity و StudentActivity (عبر BaseWebViewActivity).

    - SwipeRefreshLayout يلفّ الـ WebView لإتاحة «السحب للتحديث».
    - LinearProgressIndicator (Material) شريط تقدّم أفقي رفيع (3dp) أعلى الشاشة،
      يظهر أثناء التحميل (onPageStarted → onPageFinished) ويتحرّك 0–100.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- السحب للتحديث + الـ WebView بداخله -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- مؤشّر التحميل الأفقي — يعلو فوق الـ WebView في الأعلى -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:visibility="gone"
        android:max="100"
        android:elevation="10dp"
        app:indicatorColor="@color/progress_indicator_color"
        app:trackColor="@android:color/transparent"
        app:trackCornerRadius="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        مضيف بطاقة «تحديث متاح» (UpdateBanner) — FrameLayout فارغ مربوط بأسفل الشاشة.
        وجوده في الـXML (بدل حسابات LayoutParams برمجياً على ConstraintLayout) يجعل نفس دالّة
        العرض تصلح للرئيسية وللمنصّتين معاً.
    -->
    <FrameLayout
        android:id="@+id/bannerHost"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        شاشة قفل البصمة — تُغطّي الـWebView بالكامل حتى نجاح المصادقة.
        clickable+focusable ضروريان: بلا هما تمرّ اللمسات إلى الـWebView أسفلها.
    -->
    <LinearLayout
        android:id="@+id/lockOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="24dp"
        android:background="@color/ic_launcher_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lock_icon"
            android:textSize="52sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/lock_title"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:maxWidth="320dp"
            android:text="@string/lock_message"
            android:textColor="#CBD5E1"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnUnlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/lock_unlock" />

        <TextView
            android:id="@+id/btnLockBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:padding="10dp"
            android:text="@string/lock_back"
            android:textColor="#8B97AC"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
