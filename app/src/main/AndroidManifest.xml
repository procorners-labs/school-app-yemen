<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- صلاحيات الشبكة -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- صلاحيات التخزين لرفع الملفات (للأجهزة القديمة فقط) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- إشعارات Firebase Cloud Messaging (Android 13+ يتطلّب صلاحية صريحة وقت التشغيل) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- قفل الدخول بالبصمة (BiometricLock.kt) — USE_FINGERPRINT للأجهزة قبل أندرويد 9 فقط -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT"
        android:maxSdkVersion="28" />
    <!-- اهتزاز مصاحب لصوت التنبيه المخصّص (قناة الإشعارات + NotificationHelper) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- عتاد البصمة غير إلزامي: التطبيق يعمل كاملاً بلا قفل بصمة (القفل اختياري بيد المستخدم) -->
    <uses-feature
        android:name="android.hardware.fingerprint"
        android:required="false" />

    <application
        android:name=".SchoolApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SchoolAppYemen"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="36">

        <!--
            SplashActivity — نقطة الدخول الرئيسية (LAUNCHER).
            - تُهيئ AppConfig وتبدأ المزامنة في الخلفية.
            - theme مخصص (Theme.SchoolApp.Splash) لتلبية متطلبات AndroidX SplashScreen API.
            - تنتقل فوراً إلى MainActivity دون تأخير اصطناعي.
        -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SchoolApp.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            MainActivity — يستضيف الواجهة العامة للمدرسة (الموقع الرسمي).
            ✅ تم التصحيح: يعرض HOME_URL (AppConfig.HOME_URL) وليس CMS_URL.
            - المحتوى: الأخبار، الصور، الفيديوهات، الإحصائيات، أزرار المنصات.
            - configChanges يمنع إعادة تشغيل WebView عند تدوير الشاشة أو إظهار لوحة المفاتيح.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!--
            TeacherActivity — يستضيف منصة المعلمين.
            - windowSoftInputMode=adjustResize لضمان ظهور حقول الإدخال فوق لوحة المفاتيح.
        -->
        <activity
            android:name=".TeacherActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!--
            StudentActivity — يستضيف منصة الطلاب وأولياء الأمور.
        -->
        <activity
            android:name=".StudentActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Firebase Cloud Messaging — استقبال وعرض الإشعارات (راجع SchoolFcmService.kt) -->
        <service
            android:name=".SchoolFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/fcm_default_channel_id" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

    </application>

</manifest>