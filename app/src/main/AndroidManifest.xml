<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- صلاحيات الشبكة -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- صلاحيات التخزين لرفع الملفات (للأجهزة القديمة فقط) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- إشعارات Firebase Cloud Messaging (Android 13+ يتطلّب صلاحية صريحة وقت التشغيل) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SchoolApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SchoolAppYemen"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="36">

        <!--
            SplashActivity — نقطة الدخول الرئيسية (LAUNCHER).
            - تُهيئ AppConfig وتبدأ المزامنة في الخلفية.
            - theme مخصص (Theme.SchoolApp.Splash) لتلبية متطلبات AndroidX SplashScreen API.
            - تنتقل فوراً إلى MainActivity دون تأخير اصطناعي.
        -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SchoolApp.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            MainActivity — يستضيف الواجهة العامة للمدرسة (الموقع الرسمي).
            ✅ تم التصحيح: يعرض HOME_URL (AppConfig.HOME_URL) وليس CMS_URL.
            - المحتوى: الأخبار، الصور، الفيديوهات، الإحصائيات، أزرار المنصات.
            - configChanges يمنع إعادة تشغيل WebView عند تدوير الشاشة أو إظهار لوحة المفاتيح.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!--
            TeacherActivity — يستضيف منصة المعلمين.
            - windowSoftInputMode=adjustResize لضمان ظهور حقول الإدخال فوق لوحة المفاتيح.
        -->
        <activity
            android:name=".TeacherActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!--
            StudentActivity — يستضيف منصة الطلاب وأولياء الأمور.
        -->
        <activity
            android:name=".StudentActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!--
            DeepLinkActivity — نقطة دخول روابط yemenschoolz.com (2026-08-12، vc32).

            🔴 قبل هذا الإصدار كان `intent-filter` الوحيد في التطبيق هو MAIN+LAUNCHER —
            أي **صفر Deep Link**: كل رابط منصّة يصل من واتساب أو من إشعار كان يفتح
            المتصفّح، ولو كان التطبيق مثبَّتاً. وهذه النافذة الوحيدة لإصلاحه، فالروابط
            تُجمَّد في الـAPK ولا مزامنة ديناميكية (AppConfig.syncIfNeeded معطّلة عمداً).

            - `android:exported="true"` إلزامي لأي intent-filter من خارج التطبيق.
            - `autoVerify="true"` يجعله App Link مُتحقَّقاً (بلا منتقي تطبيقات) — ويشترط
              أن يخدم النطاق `/.well-known/assetlinks.json` ببصمة **مفتاح توقيع Play**
              لا بصمة مفتاح الرفع. بلا الملف يعمل الرابط لكن بمنتقٍ، لا يتعطّل شيء.
            - `noHistory` + `excludeFromRecents`: نشاط توجيه لحظي لا يظهر في «الأخيرة».
            - النطاقان الإرثيان (school.procorners.com · workers.dev) **لا يُضافان هنا
              عمداً**: نُسخ أندرويد قديمة تعتمدهما، وإدراجهما يخطف روابطها بلا داعٍ.

            🔴 والمطالبةُ مُقيَّدةٌ بمسار المستأجر — أُضيف 2026-09-02 قبل شحن vc33:
            هذا التطبيقُ يخدم **مدرسةً واحدة** (مدارس الإبداع · slug `abdaawatmuaz`) على
            نطاقٍ **متعدّد المستأجرين**. ومطالبةٌ بالمضيف كلِّه كانت تعترض صفحةَ المنصّة
            العامّة و**روابطَ كلّ مدرسةٍ أخرى** — أي يفتح تطبيقُ مدرسةٍ رابطَ مدرسةٍ غيرها.

            🔴 وقيدٌ تقنيّ يفسّر لماذا الـslug وحده: `pathPrefix` يطابق **المسار فقط ولا
            يرى الاستعلام**. فالأشكالُ التي تحمل هويّة المستأجر في `?school=<uuid>`
            (‏`/portal?school=…` · `/home/news.html?news=…&school=…`) **يستحيل
            تقييدُها بالمسار**، وإدراجُها يعني المطالبةَ بذلك المسار **لكلّ المستأجرين**.
            ⇒ أُسقطت، وتلك الروابطُ تفتح في المتصفّح.

            🟢 ولا يفقد أحدٌ شيئاً بهذا التضييق: المنشورُ `vc31` **بلا أيّ Deep Link
            إطلاقاً**، فأيُّ مجموعةٍ تُشحن زيادةٌ صافية لا انتقاص.
        -->
        <activity
            android:name=".DeepLinkActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="yemenschoolz.com" />
                <data android:scheme="https" android:host="www.yemenschoolz.com" />
                <!--
                    ‏المساراتُ مشتقّةٌ من عقد الوركر المقيس، لا من تخمين:
                      · `_schoolSlugFromPath` ⇒ `/^\/([a-z0-9-]+)\/?$/` بعد استبعاد
                        `_RESERVED_TOP_PATHS` ⇒ صفحةُ المدرسة **مقطعٌ واحدٌ فقط**،
                        فلا شيءَ تحتها ⇒ لا `pathPrefix`.
                      · `_DEEP_PORTAL_RE` ⇒ `/^\/(teacher|student)\/[a-z0-9-]+(?:\/[a-z0-9-]+)?\/?$/i`

                    🔴 **والـslug لاحقةٌ لا بادئة:** الصيغةُ `/teacher/<page>/<slug>` —
                    **لا** `/<slug>/teacher/`. ولذلك يلزم `pathPattern` (يطابق المسارَ
                    كاملاً) لا `pathPrefix` (يطابق من البداية فقط).

                    ‏`path` التامّة تلتقط `?news=…` معها — الاستعلامُ ليس جزءاً من المسار.

                    ⚠️ **وتدقيقٌ مقيسٌ 2026-09-05 يصحّح ما قد يُفهَم من `_DEEP_PORTAL_RE`
                    وحده:** الشكلُ ذو **المقطعين** `/teacher/<x>` يطابق ذلك التعبير فيُخدَم
                    ‏`/teacher/index.html`، **لكنّ `<x>` فيه يُقرأ تبويباً لا مدرسةً** —
                    مستخرِجُ هويّة المستأجر `_tenantKeyFrom` يشترط **ثلاثة مقاطع** ويأخذ
                    **الأخير** (‏`school-app-proxy.js:525` ⇒ `deep[2]`)، وله ضابطٌ معاكسٌ
                    صريح: `test-routes.js:496` ⇒ `['/teacher/login', '', '', 'مقطعٌ واحد =
                    تبويبٌ لا مدرسة ⇒ لا مفتاح']`.
                    ⇒ مُدخَلا `/teacher/abdaawatmuaz` و`/student/abdaawatmuaz` أدناه
                    **دفاعيّان لشكلٍ يدويٍّ محتمَل، لا روابطُ مستأجرٍ يولّدها النظام**.
                    وتُركا لأن ضررَهما صفر: لا يطالبان بمستأجرٍ آخر، والاسمُ بلا معنى
                    تبويباً. **ولا يُستدلَّ بهما على أن الشكلَ ذا المقطعين يحمل هويّة.**

                    ⚠️ **ودقّةٌ ثانية تُقال وإلّا صار «مشتقٌّ من العقد» ادّعاءً أوسعَ من
                    حقيقته:** في لغة أنماط أندرويد (`PATTERN_SIMPLE_GLOB`) النقطةُ تطابق
                    **أيَّ محرف بما فيه `/`** ⇒ `pathPattern="/teacher/.*/abdaawatmuaz"`
                    يقبل أيضاً `/teacher/a/b/abdaawatmuaz` — أوسعُ من العقد المقيس
                    (مقطعان كحدٍّ أقصى بعد المنصّة).
                    🟢 **ولا أثرَ ضارّاً لهذا الاتّساع، مقيساً لا مُفترَضاً:** الوركر
                    **لا يخدم أربعةَ مقاطع أصلاً** — `school-app-proxy.js:431` نصّاً:
                    «ومقطعان كحدٍّ أقصى: `/teacher/a/b/c` لا يُطابِق». ⇒ المسارُ الزائد
                    **لا يخصّ مستأجراً آخر**، وغايةُ ما يقع أن يُفتح داخل التطبيق مسارٌ
                    لا يخدمه الخادم. وضبطُه حرفياً يستلزم أنماطاً بلا `.` وهي غير متاحة
                    في هذه اللغة.
                -->
                <data android:path="/abdaawatmuaz" />
                <data android:path="/abdaawatmuaz/" />
                <data android:path="/teacher/abdaawatmuaz" />
                <data android:path="/teacher/abdaawatmuaz/" />
                <data android:path="/student/abdaawatmuaz" />
                <data android:path="/student/abdaawatmuaz/" />
                <data android:pathPattern="/teacher/.*/abdaawatmuaz" />
                <data android:pathPattern="/teacher/.*/abdaawatmuaz/" />
                <data android:pathPattern="/student/.*/abdaawatmuaz" />
                <data android:pathPattern="/student/.*/abdaawatmuaz/" />
            </intent-filter>
        </activity>

        <!-- Firebase Cloud Messaging — استقبال وعرض الإشعارات (راجع SchoolFcmService.kt) -->
        <service
            android:name=".SchoolFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/fcm_default_channel_id" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

    </application>

</manifest>